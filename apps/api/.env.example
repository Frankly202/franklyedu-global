NODE_ENV=development
PORT=3000
WEB_ORIGINS=http://localhost:5173

# Local development: run `bun run dev:api` from the monorepo root.
# It obtains local-only values from `supabase status --output env` in memory.
# For direct `bun run dev` use, set SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# from a local Supabase instance. Never put hosted credentials in this file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
