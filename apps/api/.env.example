NODE_ENV=development
PORT=3000
WEB_ORIGINS=http://localhost:5173

# Local development: run `bun run dev:api` from the monorepo root.
# It obtains local-only values from `supabase status --output env` in memory.
# For direct `bun run dev` use, set SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# plus the local anon key from a local Supabase instance. Never put hosted
# credentials in this file. Participant bootstrap uses the anon key with the
# verified user's bearer token so PostgreSQL auth.uid() remains trustworthy.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
