{
  "name": "franklyedu-referral-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "bun run build && node --env-file-if-exists=.env dist/src/server.js",
    "dev:local": "bun run build && node scripts/dev-local.mjs",
    "supabase:start": "node scripts/dev-local.mjs --supabase-start",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
