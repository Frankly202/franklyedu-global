# Public API origin used by server-side BFF calls; no credentials, path, query, or fragment.
# Production example (set in Vercel Production, then redeploy):
VITE_API_ORIGIN=https://franklyedu-referral-api.onrender.com
# For local API development, use http://localhost:3000 instead.
# Vite embeds this public origin at build time. The BFF uses it for session
# verification, participant bootstrap and reads, and referral submissions.

# Required by the server-only referral login/session BFF. Keep these unprefixed
# so Vite does not expose them to browser code. Use the project's Supabase URL
# and anon/publishable key; never put a service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
#
# `bun run test:auth:local` uses running local Supabase credentials from CLI
# status and an ephemeral local Express API. It overrides hosted settings only
# in its process, never rewrites .env, and does not create accounts by default.
# Explicit `bun run test:auth:local --with-account` creates one temporary local
# Auth account with generated in-memory credentials and removes it after testing.
# Public `test:smoke` runs clear local Auth configuration to avoid hosted calls.
# Approved local recovery callback:
# http://localhost:5173/referrals/recovery/callback
# Recovery dispatch/password updates are disabled in production, for hosted
# Supabase, and on every other frontend origin. No new environment variable.
# `bun run test:recovery:local` creates/removes one temporary local Auth account,
# reads only its local Mailpit email, and tests password changes. It binds the
# approved localhost:5173 origin; run only with local testing authorization.
#
# Vercel supplies VERCEL automatically for deployment-preset detection.
# NITRO_PRESET is an optional build-preset override, not an API-origin setting.
#
# Never put Supabase service-role keys, database passwords, hosting tokens, or
# other server-only credentials here or in browser-exposed VITE_* variables.
